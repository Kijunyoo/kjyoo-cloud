# deploy.mjs 설정. 이 파일을 deploy.env 로 복사해 값을 채운다.
# deploy.env 는 커밋하지 않는다(.gitignore 대상).

DEPLOY_HOST=서버주소
DEPLOY_USER=계정
DEPLOY_KEY=C:\Users\<사용자>\.ssh\<개인키>
DEPLOY_ROOT=/웹서버가/보는/상위경로
DEPLOY_NAME=사이트폴더명
VERIFY_BASE=https://kjyoo.cloud

# 정적 파일만 바꿀 때는 웹서버 재적재가 필요 없다. 필요하면 명령을 적는다.
# RELOAD_CMD=docker exec <caddy컨테이너> caddy reload --adapter caddyfile --config /etc/caddy/Caddyfile
